{
  "name": "arc-tid",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "\u003e=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @arc-tid/db migrate",
    "db:seed": "pnpm --filter @arc-tid/db seed",
    "check": "pnpm lint \u0026\u0026 pnpm typecheck \u0026\u0026 pnpm test",
    "db:reset": "docker compose down -v \u0026\u0026 docker compose up -d db",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
