{
  "name": "arc-tid",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "serve": "pnpm --filter @arc-tid/web build && pnpm -r --parallel --filter ./apps/* start",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @arc-tid/db migrate",
    "db:seed": "pnpm --filter @arc-tid/db seed",
    "check": "pnpm lint && pnpm docs:check && pnpm typecheck && pnpm test",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "e2e": "playwright test",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
