# Owner role: migrations and seed only
DATABASE_OWNER_URL=postgres://arc_owner:arc_owner_dev@localhost:5432/arc_tid
# App role: no BYPASSRLS, used by the API at runtime (D-012)
DATABASE_URL=postgres://arc_app:arc_app_dev@localhost:5432/arc_tid
SESSION_SECRET=change-me-dev-only-at-least-32-characters
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Python analytics service (apps/analytics, read-only database role; dev password only)
NEXT_PUBLIC_ANALYTICS_URL=http://localhost:8000
ANALYTICS_DATABASE_URL=postgresql://arc_analytics:arc_analytics_dev@localhost:5432/arc_tid
# Dev login (email + password) is enabled only when this is "true" and NODE_ENV != production
DEV_LOGIN_ENABLED=true
# Microsoft Entra ID (OIDC). Leave empty to disable.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:4000/api/v1/auth/entra/callback
# Read-only Outlook calendar import (Calendars.Read). Needs the Entra values above; test tenant only.
GRAPH_CALENDAR_ENABLED=false

# Login attempts per minute per IP (raise locally when running E2E repeatedly)
AUTH_RATE_LIMIT=10

# e-conomic accounting integration — SANDBOX agreements only during development (brief §1). Empty = disabled.
ECONOMIC_APP_SECRET_TOKEN=
ECONOMIC_AGREEMENT_GRANT_TOKEN=
ECONOMIC_CUSTOMER_GROUP=1
ECONOMIC_VAT_ZONE=1
ECONOMIC_LAYOUT=19
ECONOMIC_PAYMENT_TERMS=1
ECONOMIC_PRODUCT=1

# E-mail reminders (empty = disabled). For local testing use Mailpit: SMTP_HOST=localhost, SMTP_PORT=1025,
# start it with `docker compose up -d mail` and read the mails at http://localhost:8025 (nothing leaves your PC).
SMTP_HOST=
SMTP_PORT=1025
MAIL_FROM=ARCnordic Tid <noreply@arcnordic.test>
