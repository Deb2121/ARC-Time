# Owner role: migrations and seed only
DATABASE_OWNER_URL=postgres://arc_owner:arc_owner_dev@localhost:5432/arc_tid
# App role: no BYPASSRLS, used by the API at runtime (D-012)
DATABASE_URL=postgres://arc_app:arc_app_dev@localhost:5432/arc_tid
SESSION_SECRET=change-me-dev-only-at-least-32-characters
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Dev login (email + password) is enabled only when this is "true" and NODE_ENV != production
DEV_LOGIN_ENABLED=true
# Microsoft Entra ID (OIDC). Leave empty to disable.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:4000/api/v1/auth/entra/callback

# Login attempts per minute per IP (raise locally when running E2E repeatedly)
AUTH_RATE_LIMIT=10
